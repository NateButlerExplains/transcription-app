# Langfuse credentials from one shared Langfuse project.
# Do not commit real keys; copy this file to .env for local development.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Shared-project trace metadata. Set APP_ENV to development, staging, or production.
APP_ENV=local
WHISPER_MODEL=base

# Max upload size accepted by /transcribe, in MB. Oversize uploads get HTTP 413.
MAX_UPLOAD_MB=200

# Keep transcripts out of Langfuse by default. Set true only when you are comfortable
# storing transcript text in Langfuse for debugging/evaluation.
LANGFUSE_CAPTURE_TRANSCRIPT=false
